# Airflow User ID: Use 0 (root) on Windows to allow Airflow to write to mounted folders (data/, model/)
AIRFLOW_UID=0

# Default Admin UI Credentials
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=admin

# Webserver Host Port (changed to 8088 to avoid port 8080 conflicts)
AIRFLOW_WEBSERVER_PORT=8088

# Streamlit Port
STREAMLIT_PORT=8501
